					"cookie": [],
					"body": "{\n    \"message\": \"Productos encontrados\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"name\": \"Lukather\",\n            \"image\": \"guitarra_01\",\n            \"description\": \"Sonido potente con tonos cálidos. Ideal para solos intensos y acompañamientos suaves. Diseño clásico con acabado profesional.\",\n            \"price\": 299,\n            \"stock\": 10\n        },\n        {\n            \"id\": 2,\n            \"name\": \"SRV\",\n            \"image\": \"guitarra_02\",\n            \"description\": \"Perfecta para estilos agresivos y versátiles. Mástil rápido, cuerpo liviano y excelente sustain para estudio y escenario.\",\n            \"price\": 349,\n            \"stock\": 10\n        },\n        {\n            \"id\": 3,\n            \"name\": \"Borland\",\n            \"image\": \"guitarra_03\",\n            \"description\": \"Guitarra de alta precisión con pastillas activas. Tonos limpios y definidos. Equilibrada para ritmos y melodías complejas.\",\n            \"price\": 329,\n            \"stock\": 10\n        },\n        {\n            \"id\": 4,\n            \"name\": \"VAI\",\n            \"image\": \"guitarra_04\",\n            \"description\": \"Construida con materiales premium. Ideal para jazz y blues. Tono envolvente y respuesta dinámica al toque.\",\n            \"price\": 299,\n            \"stock\": 10\n        },\n        {\n            \"id\": 5,\n            \"name\": \"Thompson\",\n            \"image\": \"guitarra_05\",\n            \"description\": \"Guitarra moderna con acabado brillante. Excelente para géneros contemporáneos. Tonalidad nítida y cuerpo ergonómico.\",\n            \"price\": 399,\n            \"stock\": 10\n        },\n        {\n            \"id\": 6,\n            \"name\": \"White\",\n            \"image\": \"guitarra_06\",\n            \"description\": \"Versatilidad total para músicos exigentes. Compatible con pedales de efectos. Sonido natural y gran estabilidad de afinación.\",\n            \"price\": 329,\n            \"stock\": 10\n        },\n        {\n            \"id\": 7,\n            \"name\": \"Cobain\",\n            \"image\": \"guitarra_07\",\n            \"description\": \"Diseñada para el escenario. Ofrece presencia sonora impactante y comodidad al tocar. Muy valorada por profesionales.\",\n            \"price\": 349,\n            \"stock\": 10\n        },\n        {\n            \"id\": 8,\n            \"name\": \"Dale\",\n            \"image\": \"guitarra_08\",\n            \"description\": \"Hecha para riffs pesados y armonías claras. Acabado mate y electrónica de calidad. Sonido robusto y bien definido.\",\n            \"price\": 379,\n            \"stock\": 10\n        },\n        {\n            \"id\": 9,\n            \"name\": \"Krieger\",\n            \"image\": \"guitarra_09\",\n            \"description\": \"Modelo clásico con mejoras actuales. Ideal para principiantes y expertos. Buena proyección acústica y durabilidad.\",\n            \"price\": 289,\n            \"stock\": 10\n        },\n        {\n            \"id\": 10,\n            \"name\": \"Campbell\",\n            \"image\": \"guitarra_10\",\n            \"description\": \"Sonido profundo y sustain prolongado. Diseño elegante y cómodo para largas sesiones. Excelente balance entre cuerdas.\",\n            \"price\": 349,\n            \"stock\": 10\n        },\n        {\n            \"id\": 11,\n            \"name\": \"Reed\",\n            \"image\": \"guitarra_11\",\n            \"description\": \"Ideal para sesiones en vivo y grabación. Su tono preciso y construcción sólida aseguran confiabilidad y carácter sonoro.\",\n            \"price\": 399,\n            \"stock\": 10\n        },\n        {\n            \"id\": 12,\n            \"name\": \"Hazel\",\n            \"image\": \"guitarra_12\",\n            \"description\": \"Estilo retro con tecnología moderna. Combinación perfecta entre tradición y potencia sonora. Construcción robusta.\",\n            \"price\": 379,\n            \"stock\": 10\n        },\n        {\n            \"id\": 13,\n            \"name\": \"prueba1\",\n            \"image\": \"guitarra_xx\",\n            \"description\": \"prueba1\",\n            \"price\": 11,\n            \"stock\": 2\n        }\n    ]\n}"
